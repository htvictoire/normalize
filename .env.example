NORMALIZE_DUCKDB_MEMORY_LIMIT=4GB
NORMALIZE_REDIS_URL=redis://localhost:6378/0
NORMALIZE_DUCKDB_CACHE_DIR=./data/duckdb
NORMALIZE_POSTGRES_DSN=postgresql://normalize:normalize@localhost:5438/normalize
NORMALIZE_CONVERSION_OUTPUT_DIR=./data/outputs


NORMALIZE_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
NORMALIZE_S3_ACCESS_KEY_ID=
NORMALIZE_S3_SECRET_ACCESS_KEY=
NORMALIZE_S3_BUCKET=


# AI suggestion strategy (only used when suggestion_method="ai"; install with: pip install -e ".[ai]")
NORMALIZE_AI_PROVIDER=gemini
NORMALIZE_AI_SAMPLE_ROW_COUNT=50
NORMALIZE_GEMINI_API_KEY=
NORMALIZE_GEMINI_MODEL=gemini-3.5-flash
