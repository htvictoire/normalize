# API and worker runtime
APP_ENV=development
LOG_LEVEL=INFO

# Core dependencies
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/normalization
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Object storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Processing defaults
DUCKDB_MEMORY_LIMIT=4GB
TRACE_MODE=full
